# Modelo de configuração. Copie para ".env" e preencha os valores.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Segredo que assina o cookie de sessão. Use um texto longo e aleatório.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio

# Porta do servidor (padrão: 3001)
# PORT=3001

# Caminho alternativo do banco (útil para testes automatizados)
# DB_PATH=data/teste.db

# Senha do usuário "admin" criado automaticamente quando não há usuários no banco
# ADMIN_SENHA_INICIAL=admin123

# Proteção contra força bruta no login
# LOGIN_MAX_TENTATIVAS=5
# LOGIN_BLOQUEIO_MINUTOS=15

# Duração da sessão sem uso, em horas
# SESSAO_DURACAO_HORAS=8
